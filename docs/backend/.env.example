# Copy to .env and adjust values as needed.
APP_NAME=模型训练可视化平台
APP_ENVIRONMENT=development
APP_DEBUG=false
APP_DATABASE_URL=sqlite:///./data/app.db
APP_MODEL_STORAGE_DIR=data/models
APP_UPLOAD_STORAGE_DIR=data/uploads
# Optional dedicated script root; otherwise scripts use APP_STORAGE_ROOT or the model root.
# APP_SCRIPT_STORAGE_DIR=data/scripts
APP_MAX_SCRIPT_SIZE_BYTES=5242880
APP_MAX_DATASET_SIZE_BYTES=52428800
# Optional artifact root; defaults to APP_MODEL_STORAGE_DIR for compatibility.
# APP_STORAGE_ROOT=data/storage
APP_ALLOWED_ORIGINS=["http://localhost:5173"]
