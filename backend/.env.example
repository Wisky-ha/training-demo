# Copy to .env and override values as needed. Variables use the MODEL_PLATFORM_ prefix.
MODEL_PLATFORM_ENVIRONMENT=development
MODEL_PLATFORM_DEBUG=false
MODEL_PLATFORM_HOST=127.0.0.1
MODEL_PLATFORM_PORT=8000
MODEL_PLATFORM_DATABASE_URL=sqlite:///./data/platform.db
MODEL_PLATFORM_DATA_DIR=./data
MODEL_PLATFORM_MODEL_DIR=./data/models
MODEL_PLATFORM_SCRIPT_DIR=./data/scripts
MODEL_PLATFORM_UPLOAD_DIR=./data/uploads
MODEL_PLATFORM_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
